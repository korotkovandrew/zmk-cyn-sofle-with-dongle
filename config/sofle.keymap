/*
 * CYN Sofle (Mini Sofle / Sofle60), донгл-вариант — 60 клавиш
 *
 * Порядок биндингов проверен по config/sofle.keymap из репозитория
 * pekorali/zmk-cyn-sofle-with-dongle:
 *     ряд 0 : 6 + 6         = 12
 *     ряд 1 : 6 + 6         = 12
 *     ряд 2 : 6 + 6         = 12
 *     ряд 3 : 6 + [2] + 6   = 14   <- [2] у внутреннего края, приподняты
 *     палец : 5 + 5         = 10
 *
 * Клавиши бывших внутренних колонок старой платы:
 *     TG2 / TG3   -> две центральные клавиши 3-го ряда
 *     TO0 (Сброс) -> крайняя правая клавиша большого пальца
 *
 * ИЗМЕНЕНО: Ctrl теперь на крайней клавише большого пальца (нижний левый
 * угол), Win ушёл на мизинец в левую внешнюю колонку.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

// ----------------------------------------------------------------------------
//  L0 — Основной
// ----------------------------------------------------------------------------
        base_layer {
            display-name = "Основной";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                        &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T                         &kp Y   &kp U   &kp I      &kp O    &kp P     &kp DEL
&kp LSHFT  &kp A   &kp S   &kp D   &kp F   &kp G                         &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LGUI   &kp Z   &kp X   &kp C   &kp V   &kp B   &tog 2      &tog 3    &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                   &kp LCTRL  &kp LALT  &kp LG(SPACE)  &mo 2  &kp SPACE    &kp RET  &mo 1  &kp LBKT  &kp RBKT  &to 0
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

// ----------------------------------------------------------------------------
//  L1 — Символьный   (удерживать MO1, правый большой палец)
//        !  @  #  $  %   |   ^  &  *  (  )
//              [  {  (   |   )  }  ]  +  -
//        !  <  >  =  _   |   :  %  ?  '  "
//        `  |  ~         |               /  \
// ----------------------------------------------------------------------------
        symbol_layer {
            display-name = "Символьный";
            bindings = <
&trans  &kp EXCL   &kp AT    &kp HASH   &kp DLLR   &kp PRCNT                    &kp CARET  &kp AMPS   &kp STAR   &kp LPAR  &kp RPAR   &trans
&trans  &none      &none     &kp LBKT   &kp LBRC   &kp LPAR                     &kp RPAR   &kp RBRC   &kp RBKT   &kp PLUS  &kp MINUS  &trans
&trans  &kp EXCL   &kp LT    &kp GT     &kp EQUAL  &kp UNDER                    &kp COLON  &kp PRCNT  &kp QMARK  &kp SQT   &kp DQT    &none
&trans  &kp GRAVE  &kp PIPE  &kp TILDE  &none      &none      &none    &none    &none      &none      &none      &none     &trans     &trans
                   &trans    &trans     &trans     &trans     &trans    &trans  &trans     &none      &none      &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

// ----------------------------------------------------------------------------
//  L2 — Навигационный   (удерживать MO2 / переключить TG2)
//     F1 F2 F3 F4 F5     |   F6 F7 F8 F9 F10 PSCR
//   ^← ↑  ^→ UNDO ^R     |      WH↓ MS↑ WH↑
//   ←  ↓  →  REDO        |      MS← MS↓ MS→ HOME PGUP
//      CUT COPY PASTE    |      СКМ           END  PGDN
//   RESET — правая центральная клавиша 3-го ряда
//   ЛКМ / ПКМ — большой палец правой руки
// ----------------------------------------------------------------------------
        nav_layer {
            display-name = "Навигационный";
            bindings = <
&trans  &kp F1        &kp F2     &kp F3         &kp F4     &kp F5                             &kp F6  &kp F7          &kp F8          &kp F9           &kp F10   &kp PSCRN
&trans  &kp LC(LEFT)  &kp UP     &kp LC(RIGHT)  &kp LC(Z)  &kp LC(R)                          &none   &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &none     &none
&trans  &kp LEFT      &kp DOWN   &kp RIGHT      &kp LC(Y)  &none                              &none   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp HOME  &kp PG_UP
&trans  &none         &kp LC(X)  &kp LC(C)      &kp LC(V)  &none  &trans      &sys_reset      &none   &mkp MCLK       &none           &none            &kp END   &kp PG_DN
                      &trans     &trans         &trans     &trans  &trans      &trans  &trans  &mkp LCLK  &mkp RCLK   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };

// ----------------------------------------------------------------------------
//  L3 — Игровой   (переключается TG3)
//   как основной, но стрелки:   ; → ↑    . → ←    / → ↓    \ → →
//   MO1 / MO2 / TG2 заблокированы; TO0 и TG3 работают
// ----------------------------------------------------------------------------
        game_layer {
            display-name = "Игровой";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans    &kp UP    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none     &trans   &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT
                &trans  &trans  &trans  &none   &trans     &trans  &none   &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
