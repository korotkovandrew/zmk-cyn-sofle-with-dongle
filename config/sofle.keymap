/*
 * CYN Sofle (Mini Sofle / Sofle60), донгл-вариант — 60 клавиш
 *
 * Порядок биндингов проверен по config/sofle.keymap из репозитория
 * pekorali/zmk-cyn-sofle-with-dongle:
 *     ряд 0 : 6 + 6         = 12
 *     ряд 1 : 6 + 6         = 12
 *     ряд 2 : 6 + 6         = 12
 *     ряд 3 : 6 + [2] + 6   = 14   <- [2] у внутреннего края, приподняты
 *     палец : 5 + 5         = 10
 *
 * Клавиши бывших внутренних колонок старой платы:
 *     TG2 / TG3   -> две центральные клавиши 3-го ряда
 *     TO0 (Сброс) -> крайняя правая клавиша большого пальца
 *
 * ИЗМЕНЕНО: Ctrl теперь на крайней клавише большого пальца (нижний левый
 * угол), Win ушёл на мизинец в левую внешнюю колонку.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        MCR1: MCR1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp SEMICOLON &kp ENTER &kp LEFT_BRACE &kp ENTER>;
            label = "MCR1";
        };

        MCR2: MCR2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp COLON>;
            label = "MCR2";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ----------------------------------------------------------------------------
        //  L0 — Основной
        // ----------------------------------------------------------------------------

        base_layer {
            display-name = "Основной";
            bindings = <
&kp GRAVE       &kp N1        &kp N2        &kp N3              &kp N4  &kp N5  &kp N6     &kp N7     &kp N8         &kp N9  &kp N0     &kp BSPC
&kp ESC         &kp Q         &kp W         &kp E               &kp R   &kp T   &kp Y      &kp U      &kp I          &kp O   &kp P      &kp LEFT_BRACKET
&kp TAB         &kp A         &kp S         &kp D               &kp F   &kp G   &kp H      &kp J      &kp K          &kp L   &kp SEMI   &kp RIGHT_BRACKET
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C               &kp V   &kp B   &kp SPACE  &kp ENTER  &kp N          &kp M   &kp COMMA  &kp DOT            &kp FSLH  &kp SQT
&kp LCTRL       &kp LEFT_WIN  &kp LEFT_ALT  &kp LA(LEFT_SHIFT)  &mo 1   &mo 2   &kp LEFT   &kp RIGHT  &kp BACKSLASH  &to 3
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        // ----------------------------------------------------------------------------
        //  L1 — Символьный   (удерживать MO1, правый большой палец)
        //        !  @  #  $  %   |   ^  &  *  (  )
        //              [  {  (   |   )  }  ]  +  -
        //        !  <  >  =  _   |   :  %  ?  '  "
        //        `  |  ~         |               /  \
// ----------------------------------------------------------------------------

        navigation_layer {
            display-name = "Навигационный";
            bindings = <
&kp F1  &kp F2         &kp F3              &kp F4          &kp F5               &kp F6         &kp F7       &kp F8          &kp F9          &kp F10          &kp F11        &kp F12
&trans  &kp HOME       &kp LC(LEFT_ARROW)  &kp UP_ARROW    &kp LC(RIGHT_ARROW)  &kp END        &kp PAGE_UP  &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   &kp PAGE_DOWN  &kp K_PREV
&trans  &kp LC(Z)      &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp LC(LS(Z))  &none        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none          &kp K_PLAY_PAUSE
&trans  &kp BACKSPACE  &kp LC(X)           &kp LC(C)       &kp LC(V)            &kp DEL        &trans       &trans          &none           &mkp MCLK        &none          &none             &none  &kp K_NEXT
&trans  &trans         &trans              &none           &trans               &none          &mkp LCLK    &mkp RCLK       &none           &kp PRINTSCREEN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // ----------------------------------------------------------------------------
        //  L2 — Навигационный   (удерживать MO2 / переключить TG2)
        //     F1 F2 F3 F4 F5     |   F6 F7 F8 F9 F10 PSCR
        //   ^← ↑  ^→ UNDO ^R     |      WH↓ MS↑ WH↑
        //   ←  ↓  →  REDO        |      MS← MS↓ MS→ HOME PGUP
        //      CUT COPY PASTE    |      СКМ           END  PGDN
        //   RESET — правая центральная клавиша 3-го ряда
        //   ЛКМ / ПКМ — большой палец правой руки
        // ----------------------------------------------------------------------------

        symbol_layer {
            display-name = "Символьный";
            bindings = <
&none   &none            &none          &none             &none              &none           &none          &none      &none                 &none                  &none           &none
&trans  &kp SQT          &kp LESS_THAN  &kp GREATER_THAN  &kp DOUBLE_QUOTES  &kp DOT         &kp AMPERSAND  &MCR2      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PERCENT     &MCR1
&trans  &kp EXCLAMATION  &kp MINUS      &kp PLUS          &kp EQUAL          &kp UNDERSCORE  &kp PIPE       &kp COLON  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION    &none
&trans  &kp CARET        &kp SLASH      &kp ASTERISK      &kp BACKSLASH      &kp HASH        &trans         &trans     &kp TILDE             &kp DOLLAR             &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp AT_SIGN  &none
&trans  &trans           &trans         &trans            &none              &trans          &none          &none      &none                 &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };

        // ----------------------------------------------------------------------------
        //  L3 — Игровой   (переключается TG3)
        //   как основной, но стрелки:   ; → ↑    . → ←    / → ↓    \ → →
        //   MO1 / MO2 / TG2 заблокированы; TO0 и TG3 работают
        // ----------------------------------------------------------------------------

        gaming_layer {
            display-name = "Игровой";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &none   &none   &trans  &trans          &trans          &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
